public class Conveyer {
    static Object[] qA=new Object[5], qB=new Object[5], qC=new Object[5], qD=new Object[5];
    static int aP=0,aT=0,aS=0, bP=0,bT=0,bS=0, cP=0,cT=0,cS=0, dP=0,dT=0,dS=0;
    static int prodCount=0;
    static volatile boolean run=true;
    
    synchronized static void put(Object[] q, int[] p, int[] s, String name, int time) throws Exception {
        while(s[0]==5) { System.out.print(" ["+name+" очередь полна]"); wait(); }
        q[p[0]]=new Object(); 
        p[0]=(p[0]+1)%5; 
        s[0]++;
        System.out.print(" +"+name+"("+s[0]+"/5)");
        Thread.sleep(time);
        notifyAll();
    }
    
    synchronized static Object take(Object[] q, int[] t, int[] s, String name) throws Exception {
        while(s[0]==0) wait();
        Object o=q[t[0]]; 
        t[0]=(t[0]+1)%5; 
        s[0]--;
        System.out.print(" -"+name+"("+s[0]+"/5)");
        notifyAll();
        return o;
    }
    
    synchronized static int size(int[] s) { return s[0]; }
    
    public static void main(String[] args) throws Exception {
        System.out.println("🏭 КОНВЕЙЕР ЗАПУЩЕН\n");
        
        new Thread(()->{ while(run){ try{ put(qA,new int[]{aP},new int[]{aS},"A",1000); }catch(Exception e){}} }).start();
        new Thread(()->{ while(run){ try{ put(qC,new int[]{cP},new int[]{cS},"C",2000); }catch(Exception e){}} }).start();
        new Thread(()->{ while(run){ try{ put(qD,new int[]{dP},new int[]{dS},"D",1000); }catch(Exception e){}} }).start();
        
        new Thread(()->{ 
            while(run){ 
                try{ 
                    synchronized(Conveyer.class){
                        if(size(new int[]{cS})>0 && size(new int[]{dS})>0 && size(new int[]{bS})<5){
                            take(qC,new int[]{cT},new int[]{cS},"C");
                            take(qD,new int[]{dT},new int[]{dS},"D");
                            Thread.sleep(3000);
                            put(qB,new int[]{bP},new int[]{bS},"B",0);
                        }
                    }
                    Thread.sleep(100);
                }catch(Exception e){}
            }
        }).start();
        
        new Thread(()->{ 
            while(run){ 
                try{ 
                    synchronized(Conveyer.class){
                        if(size(new int[]{aS})>0 && size(new int[]{bS})>0){
                            take(qA,new int[]{aT},new int[]{aS},"A");
                            take(qB,new int[]{bT},new int[]{bS},"B");
                            Thread.sleep(2000);
                            System.out.println("\n🎉 ПРОДУКТ #"+(++prodCount)+" ГОТОВ! | A:"+aS+" B:"+bS+" C:"+cS+" D:"+dS);
                        }
                    }
                    Thread.sleep(100);
                }catch(Exception e){}
            }
        }).start();
        
        Thread.sleep(35000);
        run=false;
        System.out.println("\n🏁 КОНВЕЙЕР ОСТАНОВЛЕН. Всего продуктов: "+prodCount);
    }
}
