class Product { static int c=0; Product(){System.out.println("\n🎉 ПРОДУКТ #"+(++c)+" ГОТОВ!");}}
class PartA { static int c=0; PartA(){System.out.print(" A"+(++c));} }
class PartB { static int c=0; PartB(){System.out.print(" B"+(++c));} }
class PartC { static int c=0; PartC(){System.out.print(" C"+(++c));} }
class PartD { static int c=0; PartD(){System.out.print(" D"+(++c));} }

class SyncQueue {
    Object[] arr = new Object[5];
    int putIdx=0, takeIdx=0, size=0;
    
    synchronized void put(Object o) throws InterruptedException {
        while(size==5) { 
            System.out.print(" [ОЧЕРЕДЬ ПОЛНА, ОЖИДАНИЕ]"); 
            wait(); 
        }
        arr[putIdx]=o; 
        putIdx=(putIdx+1)%5; 
        size++;
        System.out.print(" +"+o.getClass().getSimpleName()+"("+size+"/5)");
        notifyAll();
    }
    
    synchronized Object take() throws InterruptedException {
        while(size==0) { 
            wait(); 
        }
        Object o=arr[takeIdx]; 
        takeIdx=(takeIdx+1)%5; 
        size--;
        System.out.print(" -"+o.getClass().getSimpleName()+"("+size+"/5)");
        notifyAll();
        return o;
    }
    
    synchronized int size() { return size; }
}

public class AssemblyLine {
    static SyncQueue qA=new SyncQueue(), qB=new SyncQueue(), qC=new SyncQueue(), qD=new SyncQueue();
    static volatile boolean run=true;
    
    static void sleep(int ms) { try{Thread.sleep(ms);}catch(Exception e){} }
    
    public static void main(String[] args) throws Exception {
        System.out.println("🏭 КОНВЕЙЕР ЗАПУЩЕН\n");
        
        // Producer A (1 сек)
        new Thread(()->{ 
            while(run){ 
                sleep(1000); 
                try{ qA.put(new PartA()); }catch(Exception e){}
            } 
        }).start();
        
        // Producer C (2 сек)
        new Thread(()->{ 
            while(run){ 
                sleep(2000); 
                try{ qC.put(new PartC()); }catch(Exception e){}
            } 
        }).start();
        
        // Producer D (1 сек)
        new Thread(()->{ 
            while(run){ 
                sleep(1000); 
                try{ qD.put(new PartD()); }catch(Exception e){}
            } 
        }).start();
        
        // Producer B из C и D (3 сек)
        new Thread(()->{ 
            while(run){ 
                try{ 
                    synchronized(AssemblyLine.class){
                        if(qC.size()>0 && qD.size()>0 && qB.size()<5){
                            PartC c = (PartC)qC.take();
                            PartD d = (PartD)qD.take();
                            System.out.print("\n🔧 Сборка B из C и D");
                            sleep(3000);
                            qB.put(new PartB());
                        }
                    }
                    sleep(100);
                }catch(Exception e){}
            }
        }).start();
        
        // Assembler продукта из A и B (2 сек)
        new Thread(()->{ 
            while(run){ 
                try{ 
                    synchronized(AssemblyLine.class){
                        if(qA.size()>0 && qB.size()>0){
                            qA.take();
                            qB.take();
                            System.out.print("\n🔨 Сборка продукта");
                            sleep(2000);
                            new Product();
                            System.out.printf(" | Очереди: A:%d B:%d C:%d D:%d\n", 
                                qA.size(), qB.size(), qC.size(), qD.size());
                        }
                    }
                    sleep(100);
                }catch(Exception e){}
            }
        }).start();
        
        // Монитор статистики
        new Thread(()->{
            while(run){
                sleep(5000);
                synchronized(AssemblyLine.class){
                    System.out.printf("\n📊 СТАТИСТИКА | A:%d B:%d C:%d D:%d\n", 
                        qA.size(), qB.size(), qC.size(), qD.size());
                }
            }
        }).start();
        
        Thread.sleep(40000);
        run=false;
        System.out.println("\n🏁 КОНВЕЙЕР ОСТАНОВЛЕН");
    }
}
