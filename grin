public class Conveyer {
    // Очереди для деталей (массивы)
    static Object[] queueA = new Object[5];
    static Object[] queueB = new Object[5];
    static Object[] queueC = new Object[5];
    static Object[] queueD = new Object[5];
    
    // Индексы для очереди A
    static int aPut = 0, aTake = 0, aSize = 0;
    // Индексы для очереди B
    static int bPut = 0, bTake = 0, bSize = 0;
    // Индексы для очереди C
    static int cPut = 0, cTake = 0, cSize = 0;
    // Индексы для очереди D
    static int dPut = 0, dTake = 0, dSize = 0;
    
    static int productCount = 0;
    static boolean running = true;
    
    // Счетчики произведенных деталей
    static int totalA = 0, totalB = 0, totalC = 0, totalD = 0;
    
    synchronized static void putA() throws InterruptedException {
        while (aSize == 5) {
            System.out.println("[A] Очередь заполнена, ожидание...");
            wait();
        }
        queueA[aPut] = new Object();
        aPut = (aPut + 1) % 5;
        aSize++;
        totalA++;
        System.out.println("[A] Произведена деталь A #" + totalA + " | Очередь: " + aSize + "/5");
        notifyAll();
    }
    
    synchronized static void putC() throws InterruptedException {
        while (cSize == 5) {
            System.out.println("[C] Очередь заполнена, ожидание...");
            wait();
        }
        queueC[cPut] = new Object();
        cPut = (cPut + 1) % 5;
        cSize++;
        totalC++;
        System.out.println("[C] Произведена деталь C #" + totalC + " | Очередь: " + cSize + "/5");
        notifyAll();
    }
    
    synchronized static void putD() throws InterruptedException {
        while (dSize == 5) {
            System.out.println("[D] Очередь заполнена, ожидание...");
            wait();
        }
        queueD[dPut] = new Object();
        dPut = (dPut + 1) % 5;
        dSize++;
        totalD++;
        System.out.println("[D] Произведена деталь D #" + totalD + " | Очередь: " + dSize + "/5");
        notifyAll();
    }
    
    synchronized static void putB() throws InterruptedException {
        while (bSize == 5) {
            System.out.println("[B] Очередь заполнена, ожидание...");
            wait();
        }
        queueB[bPut] = new Object();
        bPut = (bPut + 1) % 5;
        bSize++;
        totalB++;
        System.out.println("[B] Произведена деталь B #" + totalB + " | Очередь: " + bSize + "/5");
        notifyAll();
    }
    
    synchronized static Object takeA() throws InterruptedException {
        while (aSize == 0) wait();
        Object item = queueA[aTake];
        aTake = (aTake + 1) % 5;
        aSize--;
        notifyAll();
        return item;
    }
    
    synchronized static Object takeB() throws InterruptedException {
        while (bSize == 0) wait();
        Object item = queueB[bTake];
        bTake = (bTake + 1) % 5;
        bSize--;
        notifyAll();
        return item;
    }
    
    synchronized static Object takeC() throws InterruptedException {
        while (cSize == 0) wait();
        Object item = queueC[cTake];
        cTake = (cTake + 1) % 5;
        cSize--;
        notifyAll();
        return item;
    }
    
    synchronized static Object takeD() throws InterruptedException {
        while (dSize == 0) wait();
        Object item = queueD[dTake];
        dTake = (dTake + 1) % 5;
        dSize--;
        notifyAll();
        return item;
    }
    
    public static void main(String[] args) throws InterruptedException {
        System.out.println("=== ЗАПУСК КОНВЕЙЕРА ===\n");
        
        // Поток для деталей A (1 сек)
        Thread threadA = new Thread(() -> {
            while (running) {
                try {
                    Thread.sleep(1000);
                    putA();
                } catch (InterruptedException e) {}
            }
        });
        
        // Поток для деталей C (2 сек)
        Thread threadC = new Thread(() -> {
            while (running) {
                try {
                    Thread.sleep(2000);
                    putC();
                } catch (InterruptedException e) {}
            }
        });
        
        // Поток для деталей D (1 сек)
        Thread threadD = new Thread(() -> {
            while (running) {
                try {
                    Thread.sleep(1000);
                    putD();
                } catch (InterruptedException e) {}
            }
        });
        
        // Поток для сборки деталей B из C и D (3 сек)
        Thread threadB = new Thread(() -> {
            while (running) {
                try {
                    Thread.sleep(100);
                    synchronized (Conveyer.class) {
                        if (cSize > 0 && dSize > 0 && bSize < 5) {
                            takeC();
                            takeD();
                            System.out.println("[B] Начало сборки из C и D...");
                            Thread.sleep(3000);
                            putB();
                        }
                    }
                } catch (InterruptedException e) {}
            }
        });
        
        // Поток для сборки готового продукта из A и B (2 сек)
        Thread assembler = new Thread(() -> {
            while (running) {
                try {
                    Thread.sleep(100);
                    synchronized (Conveyer.class) {
                        if (aSize > 0 && bSize > 0) {
                            takeA();
                            takeB();
                            System.out.println("[СБОРЩИК] Начало сборки продукта...");
                            Thread.sleep(2000);
                            productCount++;
                            System.out.println("\n★★★★★ ПРОДУКТ #" + productCount + " СОБРАН ★★★★★");
                            System.out.println("Очереди: A:" + aSize + "/5 B:" + bSize + "/5 C:" + cSize + "/5 D:" + dSize + "/5\n");
                        }
                    }
                } catch (InterruptedException e) {}
            }
        });
        
        // Монитор статистики
        Thread monitor = new Thread(() -> {
            while (running) {
                try {
                    Thread.sleep(5000);
                    synchronized (Conveyer.class) {
                        System.out.println("\n=== СТАТИСТИКА ===");
                        System.out.println("Произведено: A:" + totalA + " B:" + totalB + " C:" + totalC + " D:" + totalD);
                        System.out.println("Собрано продуктов: " + productCount);
                        System.out.println("Очереди: A:" + aSize + " B:" + bSize + " C:" + cSize + " D:" + dSize);
                        System.out.println("================\n");
                    }
                } catch (InterruptedException e) {}
            }
        });
        
        threadA.start();
        threadC.start();
        threadD.start();
        threadB.start();
        assembler.start();
        monitor.start();
        
        // Работаем 40 секунд
        Thread.sleep(40000);
        running = false;
        
        Thread.sleep(1000);
        System.out.println("\n=== КОНВЕЙЕР ОСТАНОВЛЕН ===");
        System.out.println("Всего собрано продуктов: " + productCount);
    }
}
